# admin-hub 环境变量模板。复制为 .env.local 并填值。
# .env.local 永远不提交 git。

# 数据库路径（绝对路径）：
# - DB_PATH 指向 career-report 项目的 sqlite 文件（admin 主库，写 admins/service_tracking）
# - NAV_DB_PATH 指向 career-nav- 项目的 sqlite 文件（admin 只读，跨库查 nav.reports）
DB_PATH=/absolute/path/to/career-report/data/career-report.db
NAV_DB_PATH=/absolute/path/to/career-nav-/data/career-nav.db

# iron-session 加密密钥（与 career-report 完全相同的字符串；至少 32 字符，建议 64）
ADMIN_SESSION_PASSWORD=

# HTTP 部署（本机开发 / 未上 HTTPS 的生产）保持 false；上 HTTPS 后可删掉这一行（默认 true）
ADMIN_COOKIE_SECURE=false

# resume-tailor 服务地址（生成优化后简历 docx 用）。
# 不填则默认走生产 https://h100.jsai100.com/a100，本机/生产都可用，一般无需配置。
# 仅当要让本机 admin-hub 调本机 resume-tailor 时才填，例如：
# TAILOR_BASE_URL=http://localhost:3000/a100

# 开发端口（career-report 占 3000，nav 单独，admin-hub 用 3001）
PORT=3001

# 课件用户白名单 gate 接口的 shared secret。
# 智能课件(A701)登录时调 /api/teaching/gate 校验手机号是否在册，请求头带此 secret。
# A701 的 TEACHING_GATE_SECRET 必须与此值完全一致。建议用 hex（避免 dotenv 对 $ 的展开）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TEACHING_GATE_SECRET=
