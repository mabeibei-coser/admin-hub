# ─────────────────────────────────────────────────────────────────────────
# templates/.env.local.example
# 适用：Vite + Express 形态。复制到项目根作为 .env.local.example（入 git）
#       和 .env.local（不入 git，填真值）。
# 替换：<PROJECT> → 项目名大写（如 SALARY）；<your-project> → 项目名 kebab 小写
# ─────────────────────────────────────────────────────────────────────────

# ─── 必填 ────────────────────────────────────────────────────────

# AI 供应商 API key（仅服务端用，不要加 VITE_ 前缀，否则会泄露到浏览器）
<PROJECT>_API_KEY=<your-api-key-here>
<PROJECT>_MODEL=<model-name-here>
# 例（讯飞）：
#   <PROJECT>_API_KEY=<api-key>:<api-secret>
#   <PROJECT>_MODEL=astron-code-latest
# 例（OpenAI）：
#   <PROJECT>_API_KEY=sk-...
#   <PROJECT>_MODEL=gpt-4o-mini

# iron-session 密钥（≥32 字符 base64）
# 生成命令：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
<PROJECT>_SESSION_PASSWORD=<generate-with-the-command-above>

# ─── 后端服务端口 ────────────────────────────────────────────────

# Express API 端口。vite.config.js 会读这个并把 /api/* 反代到此端口。
# 本机默认 4001，生产由 admin-hub 部署 skill 自动分配。
PORT=4001

# ─── 可选 ────────────────────────────────────────────────────────

# 本地 dev 用 HTTP，cookie secure 会让浏览器丢弃 cookie，必须设 false。
# 生产 HTTPS 部署可以删掉这行（默认严格）。
<PROJECT>_COOKIE_SECURE=false

# 数据库文件路径。默认是项目根 data/<your-project>.db，部署到服务器时
# 一般指向 /var/www/<your-project>/data/<your-project>.db。
# <PROJECT>_DB_PATH=

# 子路径部署时（如 https://example.com/a500/）打开以下两项：
# VITE_BASE_PATH=/a500/
# <PROJECT>_COOKIE_PATH=/a500
